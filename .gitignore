# Default: ignore everything
*
*/

# Whitelist what we want to track
!.gitignore
!README.md
!metadata.csv

# Dataset assets
!figures/
!figures/**
!sample/
!sample/**

# Demo page (GitHub Pages) + precompute pipeline
!docs/
!docs/**
docs/superpowers/
!tools/
!tools/demo/
!tools/demo/*.py
!tools/build_demo_assets.py
!tests/
!tests/**/
!tests/**/*.py

# Experiment code (Python sources only)
!src/
!src/**/
!src/**/*.py

# Paper-relevant config files only (drop b1_svm, b4_resnet18, b5_mert, b5_mert_emb, b6_chromacnn)
