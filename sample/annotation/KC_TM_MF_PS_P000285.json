  "annotation": {
    "lyrics_regions": [
      {
        "lyrics_id": "L001",
        "start_sec": 1.7839999389648435,
        "end_sec": 12.52200073242187,
        "lyrics": "사랑 사랑"
      },
      {
        "lyrics_id": "L002",
        "start_sec": 12.56800048828125,
        "end_sec": 20.354000854492185,
        "lyrics": "내사랑아"
      },
      {
        "lyrics_id": "L003",
        "start_sec": 23.7360009765625,
        "end_sec": 34.22600097656245,
        "lyrics": "어허둥둥"
      },
      {
        "lyrics_id": "L004",
        "start_sec": 34.247999877929686,
        "end_sec": 41.921999511718745,
        "lyrics": "내사랑이야"
      },
      {
        "lyrics_id": "L005",
        "start_sec": 44.84000122070312,
        "end_sec": 52.45800170898436,
        "lyrics": "광한루서 처음보고"
      },
      {
        "lyrics_id": "L006",
        "start_sec": 55.44800109863281,
        "end_sec": 63.4260009765625,
        "lyrics": "산하지해 깊은 사랑"
      },
      {
        "lyrics_id": "L007",
        "start_sec": 66.3280029296875,
        "end_sec": 76.31400268554685,
        "lyrics": "하상견지 만야월"
      },
      {
        "lyrics_id": "L008",
        "start_sec": 76.7600030517578,
        "end_sec": 88.17800384521486,
        "lyrics": "하월삼경 밤이 짧어"
      },
      {
        "lyrics_id": "L009",
        "start_sec": 88.38400604248046,
        "end_sec": 95.68200561523436,
        "lyrics": "구곡같이 서린 정회"
      },
      {
        "lyrics_id": "L010",
        "start_sec": 98.88000335693363,
        "end_sec": 109.69800415039062,
        "lyrics": "탐탐히 풀새 없이"
      },
      {
        "lyrics_id": "L011",
        "start_sec": 109.78400604248046,
        "end_sec": 117.2500061035156,
        "lyrics": "새벽닭이 원수로구나"
      },
      {
        "lyrics_id": "L012",
        "start_sec": 120.50400390624999,
        "end_sec": 131.40200439453128,
        "lyrics": "어허둥둥"
      },
      {
        "lyrics_id": "L013",
        "start_sec": 131.42400390625,
        "end_sec": 139.0180041503906,
        "lyrics": "내사랑이지"
      },
      {
        "lyrics_id": "L014",
        "start_sec": 142.00800369262703,
        "end_sec": 152.73800415039062,
        "lyrics": "밤이 짧어 한이 되면"
      },
      {
        "lyrics_id": "L015",
        "start_sec": 152.9440020751953,
        "end_sec": 160.41000183105464,
        "lyrics": "천중명월 잡어 메고"
      },
      {
        "lyrics_id": "L016",
        "start_sec": 163.55200408935545,
        "end_sec": 171.47400390625012,
        "lyrics": "장침가로 놀아보고"
      },
      {
        "lyrics_id": "L017",
        "start_sec": 174.38399627685547,
        "end_sec": 182.28999633789064,
        "lyrics": "이내 마음 거울이요"
      },
      {
        "lyrics_id": "L018",
        "start_sec": 185.1840118408203,
        "end_sec": 195.96201171874998,
        "lyrics": "도련님 굳은 맹세"
      },
      {
        "lyrics_id": "L019",
        "start_sec": 196.08001190185547,
        "end_sec": 206.88201171875022,
        "lyrics": "내 무진 오는 밤에"
      },
      {
        "lyrics_id": "L020",
        "start_sec": 206.9279962158203,
        "end_sec": 214.58599609374997,
        "lyrics": "사랑가로 즐겨보세"
      },
      {
        "lyrics_id": "L021",
        "start_sec": 217.78400024414063,
        "end_sec": 228.54600036621093,
        "lyrics": "사랑이야 어어"
      },
      {
        "lyrics_id": "L022",
        "start_sec": 228.5920036315918,
        "end_sec": 239.1780041503906,
        "lyrics": "내사랑이로구나"
      },
      {
        "lyrics_id": "L023",
        "start_sec": 239.2799961853028,
        "end_sec": 250.08999633789062,
        "lyrics": "어어흐어 둥둥"
      },
      {
        "lyrics_id": "L024",
        "start_sec": 250.1360003662109,
        "end_sec": 258.07400024414073,
        "lyrics": "니가 내 사랑이지야"
      }
    ],
